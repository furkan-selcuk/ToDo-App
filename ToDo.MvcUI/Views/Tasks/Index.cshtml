@model List<ToDo.MvcUI.Models.TaskViewModel>

@{
    ViewData["Title"] = "Görevlerim";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2> Görevlerim</h2>
    <a asp-action="Create" class="btn" style="background-color: #fb6e02ff; color: white;">
        <i class="bi bi-plus-circle"></i> Yeni Görev
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Durum</label>
                <select name="status" class="form-select">
                    <option value="">Tümü</option>
                    <option value="0" selected="@(ViewBag.SelectedStatus == 0)">Beklemede</option>
                    <option value="1" selected="@(ViewBag.SelectedStatus == 1)">Devam Ediyor</option>
                    <option value="2" selected="@(ViewBag.SelectedStatus == 2)">Tamamlandı</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Kategori</label>
                <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">Tümü</option>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn w-100 " style="background-color: #fb6e02ff; color: white;">
                    <i class="bi bi-funnel"></i> Filtrele
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Başlık</th>
                    <!-- class tanımlarının nedeni ekran küçüldüğünde sadece önemli yerlerin gözükmesi için -->
                    <th class="d-none d-md-table-cell">Açıklama</th>
                    <th class="d-none d-md-table-cell">Durum</th>
                    <th class="d-none d-md-table-cell">Kategori</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model)
                {
                    <tr>
                        <td><strong>@task.Title</strong></td>
                        <!-- class tanımlarının nedeni ekran küçüldüğünde sadece önemli yerlerin gözükmesi için -->

                        <td class="d-none d-md-table-cell">@(task.Description ?? "-")</td>
                        <td class="d-none d-md-table-cell">

                        <!-- sql veri tabanında isim olarak değilde değer olarak tutuyorum durumları bu yüzden switch case kullandım -->
                            @switch (task.State)
                            {
                                case 0:
                                    <span class="badge bg-warning">Beklemede</span>
                                    break;
                                case 1:
                                    <span class="badge bg-info">Devam Ediyor</span>
                                    break;
                                case 2:
                                    <span class="badge bg-success">Tamamlandı</span>
                                    break;
                            }
                        </td>
                        <td class="d-none d-md-table-cell">@(task.CategoryName ?? "-")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-sm ">
                                <i class="bi bi-pencil"></i> Düzenle
                            </a>
                            <form asp-action="Delete" asp-route-id="@task.Id" method="post" class="d-inline" 
                                  onsubmit="return confirm('Bu görevi silmek istediğinizden emin misiniz?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Sil
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Henüz görev bulunmamaktadır. 
        <a asp-action="Create" class="alert-link">Yeni görev ekleyin</a>
    </div>
}
